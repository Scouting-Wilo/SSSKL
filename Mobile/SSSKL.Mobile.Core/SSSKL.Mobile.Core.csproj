<Project Sdk="Microsoft.NET.Sdk">
  <!-- Use cases and ports of the mobile app: the interfaces that Infrastructure (API client) and the MAUI app (SecureStorage, passkey sheet, navigation, dialogs) implement, the auth session, passkey sign-in, popup coordinators and app services. No MAUI or HTTP client code. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The app ships with Native AOT: enables the trim/AOT/single-file analyzers here. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SSSKL.Mobile.Domain\SSSKL.Mobile.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SSSKL.Mobile.Test" />
  </ItemGroup>
</Project>
