<?xml version="1.0" encoding="utf-8"?>
<!-- OpenCover coverage of SSSKL.Mobile.Test for SonarCloud (the scan job in .github/workflows/mobile.yml). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
